PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/blogflow
# Origin of the React app (CORS). Comma-separate several.
CLIENT_ORIGIN=http://localhost:5173

# Python AI service (chunk 1)
AI_SERVICE_URL=http://127.0.0.1:8000
# Must equal INTERNAL_API_KEY in the AI service's .env
AI_INTERNAL_KEY=change-me
# LLM steps are slow; keep this generous (ms)
AI_TIMEOUT_MS=120000

# REQUIRED, min 32 chars. Generate one:  openssl rand -base64 48
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TTL_DAYS=7
# lax works when React and API share a site (e.g. both on localhost).
# Use "none" only when they are on different sites (forces Secure cookies, needs HTTPS).
COOKIE_SAMESITE=lax
GLOBAL_RATE_MAX=300
AUTH_RATE_MAX=20
LLM_RATE_MAX=30
MAX_PROJECTS_PER_USER=50
